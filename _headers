/*
    X-Frame-Options: sameorigin
    Cross-Origin-Opener-Policy: same-origin
    Content-Security-Policy: trusted-types default; require-trusted-types-for 'script'; 
    Content-Security-Policy: default-src 'self'; 
    Content-Security-Policy: connect-src https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js.map https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css.map; 
    Content-Security-Policy: script-src 'self' 'unsafe-inline'; 
    Content-Security-Policy: style-src 'self' https://fonts.googleapis.com/ https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/; 
    Content-Security-Policy: font-src https://fonts.gstatic.com/; 
    Content-Security-Policy: media-src 'self'; 
    Content-Security-Policy: base-uri 'self';
/assets/*
    Cache-Control: public, max-age=31536000, immutable
